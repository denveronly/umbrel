// Зовнішня обробка «Завантаження актів зі «Склади»» для BAS Бухгалтерія 2.1 (керована форма).
// Забирає акти місяця з програми «Склади» (Umbrel) у локальній мережі і створює в цій базі:
//   • «Реалізація товарів і послуг» (табл. частина «Послуги»),
//   • «Рахунок на оплату покупцю».
// Контрагенти шукаються за ЄДРПОУ (немає — створюються), договори — за номером (немає — створюються),
// номенклатура — за назвою (немає — створюється послуга).
// Рахунки обліку й інші реквізити копіюються з ОСТАННЬОЇ реалізації цієї організації, зробленої вручну, —
// тож перед першим запуском у базі має бути хоча б одна правильно проведена реалізація послуг.
// Документи записуються БЕЗ проведення: перевірте й проведіть їх самі. Повторний запуск не дублює документи:
// документ шукається за ключем [T<орендар>-<місяць>] у коментарі; ще не проведений — оновлюється новими сумами,
// уже проведений — не змінюється (лише попередження, якщо сума в програмі інша).
//
// Реквізити обробки (створити в Конфігураторі): АдресПрограми (Рядок 200), Токен (Рядок 100), Обєкт (Рядок 20),
// Период (Дата, склад «Дата»), СтворюватиРахунок (Булево).

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Не ЗначениеЗаполнено(Объект.Период) Тогда
		Объект.Период = НачалоМесяца(ДобавитьМесяц(ТекущаяДата(), 1));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Обєкт) Тогда
		Объект.Обєкт = "base";
	КонецЕсли;
	Объект.СтворюватиРахунок = Истина;
КонецПроцедуры

&НаКлиенте
Процедура Завантажити(Команда)
	Если Не ЗначениеЗаполнено(Объект.АдресПрограми) Или Не ЗначениеЗаполнено(Объект.Токен) Тогда
		Сообщить("Вкажіть адресу програми (напр. http://192.168.1.50:60085) і токен з «Склади» → Налаштування → Компанії → BAS.");
		Возврат;
	КонецЕсли;
	ЗавантажитиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗавантажитиНаСервере()
	ПериодСтрокой = Формат(Объект.Период, "ДФ=yyyy-MM");
	Організації = Справочники.Организации.Выбрать();
	Всього = 0;
	Пока Організації.Следующий() Цикл
		Если Організації.ПометкаУдаления Или Не ЗначениеЗаполнено(Організації.КодПоЕДРПОУ) Тогда
			Продолжить;
		КонецЕсли;
		Дані = ЗапитАктів(ПериодСтрокой, СокрЛП(Організації.КодПоЕДРПОУ));
		Если Дані = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Акт Из Дані.acts Цикл
			Попытка
				Всього = Всього + ЗавантажитиАкт(Організації.Ссылка, Акт);
			Исключение
				Сообщить("Акт № " + Акт.number + " (" + Акт.counterparty.name + "): помилка — " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
	Сообщить("Готово. Створено документів: " + Всього + ". Перевірте і проведіть їх.");
КонецПроцедуры

&НаСервере
Функция ЗапитАктів(ПериодСтрокой, ЄДРПОУ)
	Адрес = СокрЛП(Объект.АдресПрограми);
	Захищене = Лев(НРег(Адрес), 8) = "https://";
	Адрес = СтрЗаменить(СтрЗаменить(Адрес, "https://", ""), "http://", "");
	Если Прав(Адрес, 1) = "/" Тогда
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЕсли;
	Хост = Адрес;
	Порт = ?(Захищене, 443, 80);
	Поз = СтрНайти(Адрес, ":");
	Если Поз > 0 Тогда
		Хост = Лев(Адрес, Поз - 1);
		Порт = Число(Сред(Адрес, Поз + 1));
	КонецЕсли;
	Шлях = "/bas/api/acts?period=" + ПериодСтрокой + "&edrpou=" + ЄДРПОУ + "&site=" + СокрЛП(Объект.Обєкт)
		+ "&token=" + КодироватьСтроку(СокрЛП(Объект.Токен), СпособКодированияСтроки.КодировкаURL);
	Если Захищене Тогда
		З = Новый HTTPСоединение(Хост, Порт, , , , 60, Новый ЗащищенноеСоединениеOpenSSL);
	Иначе
		З = Новый HTTPСоединение(Хост, Порт, , , , 60);
	КонецЕсли;
	Відповідь = З.Получить(Новый HTTPЗапрос(Шлях));
	Если Відповідь.КодСостояния = 403 Тогда
		Сообщить("Програма відхилила токен (403). Скопіюйте токен заново з «Склади» → Налаштування → Компанії → BAS.");
		Возврат Неопределено;
	ИначеЕсли Відповідь.КодСостояния <> 200 Тогда
		Сообщить("Програма відповіла кодом " + Відповідь.КодСостояния + " для ЄДРПОУ " + ЄДРПОУ);
		Возврат Неопределено;
	КонецЕсли;
	Читання = Новый ЧтениеJSON;
	Читання.УстановитьСтроку(Відповідь.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Результат = ПрочитатьJSON(Читання, Ложь);
	Читання.Закрыть();
	Сообщить("ЄДРПОУ " + ЄДРПОУ + ": актів у програмі — " + Результат.acts.Количество());
	Возврат Результат;
КонецФункции

&НаСервере
Функция ЗавантажитиАкт(Організація, Акт)
	Коментар = Акт.comment;
	Створено = 0;
	Контрагент = ЗнайтиКонтрагента(Акт.counterparty);
	Договір = ЗнайтиДоговір(Організація, Контрагент, Акт.contract);
	ДатаДок = ?(ЗначениеЗаполнено(Акт.date), ДатаЗРядка(Акт.date), КонецМесяца(Объект.Период)) + 12 * 3600;

	Для Каждого Вид Из СтрРазделить("РеализацияТоваровУслуг,СчетНаОплатуПокупателю", ",") Цикл
		Если Вид = "СчетНаОплатуПокупателю" И Не Объект.СтворюватиРахунок Тогда
			Продолжить;
		КонецЕсли;
		Если Метаданные.Документы.Найти(Вид) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// уже завантажений раніше (ключ орендар+місяць у коментарі): непроведений — оновлюємо, проведений — не чіпаємо
		Наявний = ЗнайтиНаявний(Вид, Акт.key);
		Если Наявний <> Неопределено Тогда
			Если Наявний.Проведен Тогда
				Если Наявний.СуммаДокумента <> Акт.total Тогда
					Сообщить("⚠ " + Вид + " № " + Наявний.Номер + " (" + Акт.counterparty.name + ") уже ПРОВЕДЕНО на "
						+ Формат(Наявний.СуммаДокумента, "ЧДЦ=2") + " грн, а в програмі тепер " + Формат(Акт.total, "ЧДЦ=2")
						+ " грн. Не змінено: скасуйте проведення документа і запустіть завантаження ще раз — або виправте вручну.");
				Иначе
					Сообщить(Вид + " № " + Наявний.Номер + " — без змін (проведено)");
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Док = Наявний.ПолучитьОбъект();
			Оновлення = Истина;
		Иначе
			Док = Документы[Вид].СоздатьДокумент();
			Оновлення = Ложь;
		КонецЕсли;
		Зразок = ?(Оновлення, Неопределено, ОстаннійДокумент(Вид, Організація));
		Если Оновлення Тогда
			// рахунки обліку лишаються ті, що вже в документі
		ИначеЕсли Зразок <> Неопределено Тогда
			// рахунки обліку, тип цін, підрозділ тощо — як у документі, зробленому бухгалтером
			Пропустити = ",Контрагент,ДоговорКонтрагента,Комментарий,СуммаДокумента,ДокументОснование,Сделка,";
			Для Каждого Рекв Из Зразок.Метаданные().Реквизиты Цикл
				Если СтрНайти(Пропустити, "," + Рекв.Имя + ",") = 0 Тогда
					Док[Рекв.Имя] = Зразок[Рекв.Имя];
				КонецЕсли;
			КонецЦикла;
		Иначе
			Док.Заполнить(Неопределено);
		КонецЕсли;
		Шапка = Новый Структура;
		Шапка.Вставить("Дата", ДатаДок);
		Шапка.Вставить("Организация", Організація);
		Шапка.Вставить("Контрагент", Контрагент);
		Шапка.Вставить("ДоговорКонтрагента", Договір);
		Шапка.Вставить("ВалютаДокумента", Договір.ВалютаВзаиморасчетов);
		Шапка.Вставить("КурсВзаиморасчетов", 1);
		Шапка.Вставить("КратностьВзаиморасчетов", 1);
		Шапка.Вставить("СуммаВключаетНДС", Истина);
		Шапка.Вставить("Комментарий", Коментар);
		Шапка.Вставить("СуммаДокумента", Акт.total);
		ЗаполнитьЗначенияСвойств(Док, Шапка);

		ІмяТЧ = ?(Док.Метаданные().ТабличныеЧасти.Найти("Услуги") <> Неопределено, "Услуги", "Товары");
		ТЧ = Док[ІмяТЧ];
		ЗразокРядка = Неопределено;
		Если Оновлення И ТЧ.Количество() > 0 Тогда
			ЗразокРядка = ТЧ.Выгрузить()[0];          // рахунки рядка — з першого рядка цього ж документа
		ИначеЕсли Зразок <> Неопределено И Зразок[ІмяТЧ].Количество() > 0 Тогда
			ЗразокРядка = Зразок[ІмяТЧ][0];
		КонецЕсли;
		ТЧ.Очистить();
		Ставка = СтавкаПДВ(Акт.vat_rate);
		Для Каждого Р Из Акт.lines Цикл
			Рядок = ТЧ.Добавить();
			Если ЗразокРядка <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(Рядок, ЗразокРядка, , "НомерСтроки");
			КонецЕсли;
			Поля = Новый Структура;
			Поля.Вставить("Номенклатура", ЗнайтиНоменклатуру(Р.nomenclature));
			Поля.Вставить("Содержание", Р.content);
			Поля.Вставить("Количество", Р.qty);
			Поля.Вставить("Цена", Р.price);
			Поля.Вставить("Сумма", Р.sum);
			Поля.Вставить("СтавкаНДС", Ставка);
			Поля.Вставить("СуммаНДС", Р.vat);
			ЗаполнитьЗначенияСвойств(Рядок, Поля);
		КонецЦикла;
		Док.Записать(РежимЗаписиДокумента.Запись);
		Сообщить(Вид + " № " + Док.Номер + ?(Оновлення, " — оновлено: ", " — створено: ") + Акт.counterparty.name + ", "
			+ Формат(Акт.total, "ЧДЦ=2") + " грн");
		Створено = Створено + 1;
	КонецЦикла;
	Возврат Створено;
КонецФункции

&НаСервере
Функция ЗнайтиНаявний(Вид, Ключ)
	Запит = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Документ." + Вид + " КАК Д
		|ГДЕ НЕ Д.ПометкаУдаления И ВЫРАЗИТЬ(Д.Комментарий КАК СТРОКА(300)) ПОДОБНО &К
		|УПОРЯДОЧИТЬ ПО Д.Дата УБЫВ");
	Запит.УстановитьПараметр("К", "%[" + Ключ + "]%");
	В = Запит.Выполнить().Выбрать();
	Если В.Следующий() Тогда
		Возврат В.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ЄДокумент(Вид, Коментар)
	Запит = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка ИЗ Документ." + Вид + " КАК Д
		|ГДЕ НЕ Д.ПометкаУдаления И ВЫРАЗИТЬ(Д.Комментарий КАК СТРОКА(300)) ПОДОБНО &К");
	Запит.УстановитьПараметр("К", "%" + Коментар + "%");
	Возврат Не Запит.Выполнить().Пустой();
КонецФункции

&НаСервере
Функция ОстаннійДокумент(Вид, Організація)
	Запит = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Документ." + Вид + " КАК Д
		|ГДЕ Д.Организация = &О И НЕ Д.ПометкаУдаления И НЕ ВЫРАЗИТЬ(Д.Комментарий КАК СТРОКА(300)) ПОДОБНО ""Склади:%""
		|УПОРЯДОЧИТЬ ПО Д.Дата УБЫВ");
	Запит.УстановитьПараметр("О", Організація);
	В = Запит.Выполнить().Выбрать();
	Если В.Следующий() Тогда
		Возврат В.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ЗнайтиКонтрагента(К)
	Посилання = Справочники.Контрагенты.ПустаяСсылка();
	Если ЗначениеЗаполнено(К.edrpou) Тогда
		Посилання = Справочники.Контрагенты.НайтиПоРеквизиту("КодПоЕДРПОУ", СокрЛП(К.edrpou));
	КонецЕсли;
	Если Посилання.Пустая() Тогда
		Посилання = Справочники.Контрагенты.НайтиПоНаименованию(К.name, Истина);
	КонецЕсли;
	Если Не Посилання.Пустая() Тогда
		Возврат Посилання;
	КонецЕсли;
	Об = Справочники.Контрагенты.СоздатьЭлемент();
	Поля = Новый Структура;
	Поля.Вставить("Наименование", К.name);
	Поля.Вставить("НаименованиеПолное", К.name);
	Поля.Вставить("КодПоЕДРПОУ", ?(К.edrpou = Неопределено, "", К.edrpou));
	Поля.Вставить("ИНН", ?(К.ipn = Неопределено, "", К.ipn));
	Поля.Вставить("Покупатель", Истина);
	ЗаполнитьЗначенияСвойств(Об, Поля);
	Попытка
		Об.ЮрФизЛицо = ?(К.person, Перечисления.ЮрФизЛицо.ФизЛицо, Перечисления.ЮрФизЛицо.ЮрЛицо);
	Исключение
	КонецПопытки;
	Об.Записать();
	Сообщить("Створено контрагента: " + К.name);
	Возврат Об.Ссылка;
КонецФункции

&НаСервере
Функция ЗнайтиДоговір(Організація, Контрагент, Д)
	Номер = ?(Д.number = Неопределено, "", СокрЛП(Д.number));
	Запит = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка ИЗ Справочник.ДоговорыКонтрагентов КАК Д
		|ГДЕ Д.Владелец = &К И Д.Организация = &О И НЕ Д.ПометкаУдаления
		|	И (Д.Номер = &Н ИЛИ &Н = """")
		|УПОРЯДОЧИТЬ ПО Д.Дата УБЫВ");
	Запит.УстановитьПараметр("К", Контрагент);
	Запит.УстановитьПараметр("О", Організація);
	Запит.УстановитьПараметр("Н", Номер);
	В = Запит.Выполнить().Выбрать();
	Если В.Следующий() Тогда
		Возврат В.Ссылка;
	КонецЕсли;
	Об = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	Об.Владелец = Контрагент;
	Поля = Новый Структура;
	Поля.Вставить("Организация", Організація);
	Поля.Вставить("Наименование", "Договір" + ?(Номер = "", "", " № " + Номер)
		+ ?(ЗначениеЗаполнено(Д.date), " від " + Формат(ДатаЗРядка(Д.date), "ДФ=dd.MM.yyyy"), ""));
	Поля.Вставить("Номер", Номер);
	Если ЗначениеЗаполнено(Д.date) Тогда
		Поля.Вставить("Дата", ДатаЗРядка(Д.date));
	КонецЕсли;
	Поля.Вставить("ВалютаВзаиморасчетов", Константы.ВалютаРегламентированногоУчета.Получить());
	ЗаполнитьЗначенияСвойств(Об, Поля);
	Попытка
		Об.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	Исключение
	КонецПопытки;
	Об.Записать();
	Сообщить("Створено договір: " + Об.Наименование + " (" + Контрагент + ")");
	Возврат Об.Ссылка;
КонецФункции

&НаСервере
Функция ЗнайтиНоменклатуру(Назва)
	Посилання = Справочники.Номенклатура.НайтиПоНаименованию(Назва, Истина);
	Если Не Посилання.Пустая() Тогда
		Возврат Посилання;
	КонецЕсли;
	Об = Справочники.Номенклатура.СоздатьЭлемент();
	Поля = Новый Структура("Наименование,НаименованиеПолное,Услуга", Назва, Назва, Истина);
	ЗаполнитьЗначенияСвойств(Об, Поля);
	Об.Записать();
	Сообщить("Створено номенклатуру (послугу): " + Назва + " — перевірте її рахунки обліку.");
	Возврат Об.Ссылка;
КонецФункции

&НаСервере
Функция СтавкаПДВ(Відсоток)
	Попытка
		Если Відсоток = 20 Тогда
			Возврат Перечисления.СтавкиНДС.НДС20;
		ИначеЕсли Відсоток = 7 Тогда
			Возврат Перечисления.СтавкиНДС.НДС7;
		КонецЕсли;
		Возврат Перечисления.СтавкиНДС.БезНДС;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

